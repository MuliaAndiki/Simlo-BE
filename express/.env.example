DATABASE_URL=postgresql://user:password@localhost:5432/simlo_test
JWT_SECRET=your-jwt-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
PORT=5000
INTERNAL_API_SECRET=your-internal-api-secret

# URL FastAPI ML service (deploy terpisah → ganti ke URL production FastAPI)
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=30000

# fast/.env → BACKEND_URL harus mengarah ke URL Express ini
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# CI memakai nilai tetap "ci-test-internal-api-secret" (lihat .github/workflows/ci.yml)
