# URL Express API (proxy backend) — wajib saat deploy terpisah
BACKEND_URL=http://localhost:5000

# Opsional: origin tambahan (pisahkan dengan koma), mis. frontend production
# CORS_ALLOWED_ORIGINS=https://simlo.app,https://www.simlo.app

INTERNAL_API_SECRET=your-internal-api-secret
ML_MODEL_VERSION=best.pt-v1.0.0
ML_CONFIDENCE_THRESHOLD=0.5
ML_HOST=0.0.0.0
ML_PORT=8000

# INTERNAL_API_SECRET harus sama dengan express/.env
# express/.env → ML_SERVICE_URL harus mengarah ke URL FastAPI ini
